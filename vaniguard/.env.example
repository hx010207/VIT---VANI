# VaniGuard Environment Variables Template
# Exactly as specified in section 4

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_jwt_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

KMS_MASTER_KEY=fresh_random_32_byte_base64_string
JWT_SECRET=fresh_random_64_character_hex_string
JWT_ALGORITHM=HS256

API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=production
CORS_ORIGINS=["*"]
REDIS_URL=redis://localhost:6379/0
WORKER_CONCURRENCY=4

AUDIO_SAMPLE_RATE=16000
AUDIO_FRAME_MS=100

ASR_PROVIDER=faster_whisper
ASR_MODEL=small
ASR_API_KEY=

SPEAKER_MODEL=ecapa_tdnn
RISK_SIGNAL_CONFIG_VERSION=v1
CIRCUIT_BREAK_JITTER_RANGE=5

LOG_LEVEL=INFO
LOG_FORMAT=json
